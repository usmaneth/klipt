# Copy this file to .env and fill in real values. Do not commit .env.

# GIPHY API key for the GIF search panel in the video editor.
# Get a key at https://developers.giphy.com/
VITE_GIPHY_API_KEY=

# Tenor API key, used as a fallback GIF source when the GIPHY request fails.
# Get a key at https://tenor.com/gifapi
VITE_TENOR_API_KEY=
